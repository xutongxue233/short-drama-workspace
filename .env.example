# Authenticated workspace; loopback-only by default. See SECURITY.md for shared access.
API_PORT=3001
WEB_PORT=5173
# Optional separate location for persistent project data
# Relative paths are resolved from the project root, not the terminal directory.
# WORKBENCH_DATA_DIR=./data

# Optional shared deployment behind an HTTPS reverse proxy.
# WORKBENCH_HOST=127.0.0.1
# WORKBENCH_ORIGIN=https://studio.example.com
# Enable only when the same-host proxy overwrites X-Forwarded-For with the client IP.
# WORKBENCH_TRUST_PROXY=false
# For first setup via the shared origin, provide a random token of at least 32 characters.
# Remove it after the first administrator has been created.
# WORKBENCH_SETUP_TOKEN=
